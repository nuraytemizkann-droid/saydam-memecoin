{
  "name": "saydam-launch-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contract:compile": "node scripts/hardhat-local.mjs compile",
    "contract:test": "node scripts/hardhat-local.mjs compile && node --test test/*.test.mjs && node scripts/check-contract-abi.mjs",
    "security:audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "ethers": "6.17.0",
    "hardhat": "3.18.0",
    "typescript": "5.9.3"
  }
}
